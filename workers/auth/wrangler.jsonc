{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "auth",
    "main": "src/index.ts",
    "compatibility_date": "2025-11-15",
    "observability": {
        "enabled": true
    },
    "routes": [
        {
            "pattern": "api.zyreny.com/auth*",
            "zone_id": "272c3dc017aa4a2c6e28d0e7a44de6ad"
        }
    ],
    "d1_databases": [
        {
            "binding": "USER_DB",
            "database_name": "auth",
            "database_id": "f3013c5a-aa8d-406c-8fcf-078a0dd6b58b"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "TOKEN_KV",
            "id": "73dcfb09777e4b14ae0a2eebbab00985",
            "preview_id": "4dfaad6ad82044b0bcaec992cf1bdcb4"
        },
        {
            "binding": "VER_KV",
            "id": "7d178b48384d4366ab8427d0a7401b39",
            "preview_id": "452c1c9a35ff4d9985a2d93a442ad3ca"
        }
    ]
}
